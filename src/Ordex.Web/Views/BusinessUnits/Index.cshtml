@model IReadOnlyList<BusinessUnitListItem>
@{
    var isSuper = CurrentUser.IsSuperAdmin;
    ViewData["Title"] = CurrentUser.BusinessUnitId != 0 ? "Business unit" : "Business units";
    var groups = Model.GroupBy(u => new { u.CompanyId, u.CompanyName }).ToList();
}
<div class="page-head">
    <div>
        <h1 class="d-none d-lg-block">@ViewData["Title"]</h1>
        <div class="sub">Shops, brands or pages inside a company.</div>
    </div>
    @if (isSuper)
    {
        <div class="page-actions"><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New unit</a></div>
    }
</div>

@if (!isSuper)
{
    <div class="info-line"><i class="bi bi-info-circle"></i><span>You can edit unit names and codes. Adding, deleting or switching units on/off is done by the Super Admin.</span></div>
}

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model="@(("bi-diagram-3", "No business units", isSuper ? "Create a unit for each shop or page." : "Ask the Super Admin to add a unit."))" />
}
else
{
    foreach (var g in groups)
    {
        if (isSuper && groups.Count > 1)
        {
            <div class="org-group-title"><i class="bi bi-building"></i> @g.Key.CompanyName</div>
        }
        <div class="list-card org-list mb-2">
            @foreach (var u in g)
            {
                <div class="org-row @(u.IsActive ? "" : "inactive")">
                    <span class="icon-circle @(u.IsActive ? "primary" : "")"><i class="bi bi-shop"></i></span>
                    <a class="grow" asp-action="Edit" asp-route-id="@u.Id">
                        <div class="title">@u.UnitName <span class="badge-soft">@u.UnitCode</span></div>
                        <div class="meta">@u.CompanyName</div>
                    </a>
                    <span class="status-dot @(u.IsActive ? "on" : "off")">@(u.IsActive ? "Active" : "Inactive")</span>
                    <div class="org-actions">
                        @if (isSuper)
                        {
                            <div class="dropdown">
                                <button class="btn btn-ghost btn-icon btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions for @u.UnitName"><i class="bi bi-three-dots-vertical"></i></button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@u.Id"><i class="bi bi-pencil"></i> Edit</a>
                                    <form method="post" asp-action="SetActive" asp-route-id="@u.Id"
                                          data-confirm="@(u.IsActive ? $"Switch off {u.UnitName}? Its staff won't be able to sign in until you switch it on again." : $"Switch on {u.UnitName}?")"
                                          data-confirm-text="@(u.IsActive ? "Switch off" : "Switch on")" data-confirm-style="@(u.IsActive ? "btn-danger" : "btn-primary")">
                                        <input type="hidden" name="active" value="@(u.IsActive ? "false" : "true")" />
                                        <button type="submit" class="dropdown-item"><i class="bi @(u.IsActive ? "bi-toggle-off" : "bi-toggle-on")"></i> @(u.IsActive ? "Make inactive" : "Make active")</button>
                                    </form>
                                    <div class="dropdown-divider"></div>
                                    <form method="post" asp-action="Delete" asp-route-id="@u.Id"
                                          data-confirm="Delete @u.UnitName permanently? This only works while the unit has no users or records." data-confirm-text="Delete" data-confirm-style="btn-danger">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash3"></i> Delete</button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-ghost btn-icon btn-sm" asp-action="Edit" asp-route-id="@u.Id" aria-label="Edit @u.UnitName"><i class="bi bi-pencil"></i></a>
                        }
                    </div>
                </div>
            }
        </div>
    }
}
