@model IReadOnlyList<Ordex.Core.Entities.Company>
@{
    ViewData["Title"] = "Companies";
    var activeCount = Model.Count(c => c.IsActive);
}
<div class="page-head">
    <div>
        <h1 class="d-none d-lg-block">Companies</h1>
        <div class="sub">@Model.Count companies · @activeCount active. Each company has its own business units, users and data.</div>
    </div>
    <div class="page-actions"><a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New company</a></div>
</div>

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model="@(("bi-buildings", "No companies", "Create the first company to get started."))" />
}
else
{
    <div class="list-card org-list">
        @foreach (var c in Model)
        {
            <div class="org-row @(c.IsActive ? "" : "inactive")">
                <span class="icon-circle @(c.IsActive ? "primary" : "")"><i class="bi bi-building"></i></span>
                <a class="grow" asp-action="Edit" asp-route-id="@c.Id">
                    <div class="title">@c.CompanyName <span class="badge-soft">@c.CompanyCode</span></div>
                    <div class="meta">@(c.Phone ?? "No phone") · @c.PurchaseCurrency → @c.SalesCurrency · rate @Fmt.Rate(c.DefaultExchangeRate)</div>
                </a>
                <span class="status-dot @(c.IsActive ? "on" : "off")">@(c.IsActive ? "Active" : "Inactive")</span>
                <div class="org-actions">
                    <a class="btn btn-ghost btn-icon btn-sm d-none d-md-inline-flex" asp-controller="BusinessUnits" asp-action="Create" asp-route-companyId="@c.Id" title="Add business unit" aria-label="Add business unit to @c.CompanyName"><i class="bi bi-diagram-3"></i></a>
                    <div class="dropdown">
                        <button class="btn btn-ghost btn-icon btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions for @c.CompanyName"><i class="bi bi-three-dots-vertical"></i></button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a class="dropdown-item" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i> Edit</a>
                            <a class="dropdown-item" asp-controller="BusinessUnits" asp-action="Create" asp-route-companyId="@c.Id"><i class="bi bi-diagram-3"></i> Add business unit</a>
                            <form method="post" asp-action="SetActive" asp-route-id="@c.Id"
                                  data-confirm="@(c.IsActive ? $"Switch off {c.CompanyName}? Its users won't be able to sign in until you switch it on again." : $"Switch on {c.CompanyName}?")"
                                  data-confirm-text="@(c.IsActive ? "Switch off" : "Switch on")" data-confirm-style="@(c.IsActive ? "btn-danger" : "btn-primary")">
                                <input type="hidden" name="active" value="@(c.IsActive ? "false" : "true")" />
                                <button type="submit" class="dropdown-item"><i class="bi @(c.IsActive ? "bi-toggle-off" : "bi-toggle-on")"></i> @(c.IsActive ? "Make inactive" : "Make active")</button>
                            </form>
                            <div class="dropdown-divider"></div>
                            <form method="post" asp-action="Delete" asp-route-id="@c.Id"
                                  data-confirm="Delete @c.CompanyName permanently? This only works while the company has no users or records." data-confirm-text="Delete" data-confirm-style="btn-danger">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash3"></i> Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
