@model StockInput
@inject Ordex.Core.Abstractions.Services.ILookupService Lookups
@{
    ViewData["Title"] = Model.IsNew ? "Add extra item" : "Edit extra item";
    ViewData["Back"] = Url.Action("Index", new { tab = StockTab.Extra });
    var defaultRate = await Lookups.DefaultExchangeRateAsync(Model.CompanyId);
}

<div class="row justify-content-center">
<div class="col-12 col-lg-8 col-xl-6">
    <div class="page-head d-none d-lg-flex">
        <div><h1>@ViewData["Title"]</h1><div class="sub">Products bought extra to balance the luggage weight.</div></div>
    </div>

    <partial name="_FormErrors" />

    <form method="post" enctype="multipart/form-data" novalidate
          asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@(Model.IsNew ? null : Model.Id)"
          data-order-form data-sgd-field="PriceSgd" data-bdt-field="PriceBdt" data-is-new="@(Model.IsNew ? "true" : "false")" data-default-rate="@Fmt.Rate(defaultRate)" data-sale-symbol="@Money.SaleSymbol" data-sale-code="@Money.SaleCode" data-buy-code="@Money.BuyCode" data-sale-decimals="@Money.Sales.Decimals">
        <input type="hidden" asp-for="ProductImage" />

        @if (Model.IsNew)
        {
            @await Component.InvokeAsync("ScopeFields", new { companyId = Model.CompanyId, businessUnitId = Model.BusinessUnitId })
        }

        <section class="form-section">
            <div class="mb-3">
                <label asp-for="ProductName" class="form-label"></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName"></span>
            </div>
            <div class="mb-3">
                <partial name="_ImagePicker" model="@((Model.ProductImage, "Product image"))" />
            </div>
            <div class="mb-3">
                <label asp-for="ProductLink" class="form-label"></label>
                <input asp-for="ProductLink" class="form-control" type="text" inputmode="url" autocapitalize="none" spellcheck="false" />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label asp-for="ProductSize" class="form-label"></label>
                    <input asp-for="ProductSize" class="form-control" />
                </div>
                <div class="col-6">
                    <label asp-for="EntryDate" class="form-label"></label>
                    <input asp-for="EntryDate" class="form-control" type="date" value="@Fmt.InputDate(Model.EntryDate)" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="BatchId" class="form-label"></label>
                @await Component.InvokeAsync("BatchSelect", new { selected = Model.BatchId, companyId = Model.CompanyId, businessUnitId = Model.BusinessUnitId })
                <div class="form-hint"><i class="bi bi-info-circle"></i> <span data-rate-label></span></div>
            </div>
            <div class="row g-3">
                <div class="col-6">
                    <label asp-for="PriceSgd" class="form-label"></label>
                    <div class="input-group"><span class="input-group-text">@(Money.BuySymbol == "" ? Money.BuyCode : Money.BuySymbol)</span><input asp-for="PriceSgd" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" /></div>
                </div>
                <div class="col-6">
                    <label asp-for="PriceBdt" class="form-label"></label>
                    <div class="input-group"><span class="input-group-text">@(Money.SaleSymbol == "" ? Money.SaleCode : Money.SaleSymbol)</span><input asp-for="PriceBdt" class="form-control" type="number" min="0" step="0.01" inputmode="decimal" /></div>
                </div>
            </div>
            <div class="mt-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </section>

        <div class="form-actions">
            <a class="btn btn-light-ghost" href="@ViewData["Back"]">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save</button>
        </div>
    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/order-form.js" asp-append-version="true"></script>
}
