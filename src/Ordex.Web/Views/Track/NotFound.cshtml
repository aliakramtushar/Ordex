@{
    Layout = "_TrackLayout";
    ViewData["Title"] = "Link not found";
}
<main class="tk-wrap">
    <section class="tk-card tk-empty">
        <div class="tk-empty-icon"><i class="bi bi-link-45deg"></i></div>
        <h1>This link isn't working</h1>
        <p>The order link may be incomplete, or the shop has replaced it with a new one. Please ask the shop to send you the link again.</p>
    </section>
    <footer class="tk-foot">Order tracking by <b>Ordex</b></footer>
</main>
