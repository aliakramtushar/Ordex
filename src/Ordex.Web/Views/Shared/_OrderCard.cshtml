@model OrderListItem
@*
    One order as a card. Used on the order list, batch details and customer history.
    Status actions post back to OrdersController and return to the current page.
*@
@{
    var returnUrl = ViewData["ReturnUrl"] as string ?? Context.Request.Path + Context.Request.QueryString;
    var css = Fmt.StatusClass(Model.Status);
    var received = Model.AdvanceAmount + Model.CollectedAmount;
    var fill = JsonSerializer.Serialize(new
    {
        OrderId = Model.Id,
        CollectedAmount = Model.DueAmount,
        RefundAmount = 0,
        label = $"{Model.OrderNo} · {Model.CustomerName}",
        received = Money.Sale(received),
        due = Money.Sale(Model.DueAmount)
    });
    var social = Fmt.SafeUrl(Model.SocialLink);
}
<article class="order-card @css">
    <a class="oc-top" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id">
        <partial name="_Thumb" model="@Model.ProductImage" />
        <div class="min-w-0 flex-grow-1">
            <div class="d-flex justify-content-between gap-2 align-items-start">
                <div class="oc-title text-truncate-2">@Model.ProductName</div>
                <partial name="_StatusBadge" model="@Model.Status" />
            </div>
            <div class="oc-meta">
                <span>@Model.OrderNo</span>
                <span>@Fmt.Date(Model.OrderDate)</span>
                @if (!string.IsNullOrEmpty(Model.ProductSize)) { <span>Size @Model.ProductSize</span> }
                @if (!string.IsNullOrEmpty(Model.BatchNo)) { <span><i class="bi bi-airplane"></i> @Model.BatchNo</span> }
                @if (CurrentUser.BusinessUnitId == 0 && !string.IsNullOrEmpty(Model.BusinessUnitName)) { <span><i class="bi bi-shop"></i> @Model.BusinessUnitName</span> }
            </div>
        </div>
    </a>

    <div class="oc-customer">
        <div class="min-w-0">
            <div class="fw-500 text-truncate">
                @Model.CustomerName
                @if (social is not null)
                {
                    <a href="@social" target="_blank" rel="noopener noreferrer nofollow" class="ms-1" aria-label="Open social profile"><i class="bi bi-box-arrow-up-right small"></i></a>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.DeliveryAddress))
            {
                <div class="text-muted small text-truncate">@Model.DeliveryAddress</div>
            }
        </div>
        <a class="call" href="@Fmt.Tel(Model.Mobile)"><i class="bi bi-telephone"></i> @Model.Mobile</a>
    </div>

    <div class="oc-money">
        <div><div class="lbl">Price</div><div class="val">@Money.Sale(Model.SellingPrice)</div></div>
        @if (Model.Status == OrderStatus.Delivered)
        {
            <div><div class="lbl">Collected</div><div class="val">@Money.Sale(received)</div></div>
        }
        else if (Model.Status == OrderStatus.Returned)
        {
            <div><div class="lbl">Advance</div><div class="val">@Money.Sale(Model.AdvanceAmount)</div></div>
        }
        else
        {
            <div><div class="lbl">Due</div><div class="val due">@Money.Sale(Model.DueAmount)</div></div>
        }
        <div><div class="lbl">Profit</div><div class="val">@Money.Sale(Model.Profit)</div></div>
    </div>

    @if (Model.Status == OrderStatus.Returned && !string.IsNullOrEmpty(Model.ReturnReason))
    {
        <div class="small text-2"><i class="bi bi-chat-left-text"></i> @Model.ReturnReason</div>
    }

    @if (Model.Status != OrderStatus.Returned)
    {
        <div class="oc-actions">
            @if (OrderWorkflow.CanDispatch(Model.Status))
            {
                <form method="post" asp-controller="Orders" asp-action="Dispatch">
                    <input type="hidden" name="OrderId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-amber btn-sm" data-busy-text="Updating…"><i class="bi bi-truck"></i> Go for delivery</button>
                </form>
            }
            @if (OrderWorkflow.CanDeliver(Model.Status))
            {
                <button type="button" class="btn btn-green btn-sm" data-bs-toggle="modal" data-bs-target="#deliverModal" data-fill="@fill"><i class="bi bi-check2-circle"></i> Delivered</button>
            }
            @if (OrderWorkflow.CanReturn(Model.Status) && Model.Status == OrderStatus.OutForDelivery)
            {
                <button type="button" class="btn btn-red-soft btn-sm" data-bs-toggle="modal" data-bs-target="#returnModal" data-fill="@fill"><i class="bi bi-arrow-counterclockwise"></i> Return</button>
            }

            <div class="dropdown" style="flex:0 0 auto">
                <button class="btn btn-light-ghost btn-sm btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions"><i class="bi bi-three-dots"></i></button>
                <div class="dropdown-menu dropdown-menu-end">
                    <a class="dropdown-item" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-eye"></i> View details</a>
                    <a class="dropdown-item" asp-controller="Orders" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
                    @if (OrderWorkflow.CanUndoDispatch(Model.Status))
                    {
                        <form method="post" asp-controller="Orders" asp-action="UndoDispatch">
                            <input type="hidden" name="OrderId" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="dropdown-item"><i class="bi bi-arrow-left-circle"></i> Back to pre-order</button>
                        </form>
                    }
                    @if (Model.Status == OrderStatus.Delivered)
                    {
                        <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#returnModal" data-fill="@fill"><i class="bi bi-arrow-counterclockwise"></i> Return</button>
                    }
                    @if (OrderWorkflow.CanDelete(Model.Status))
                    {
                        <div class="dropdown-divider"></div>
                        <form method="post" asp-controller="Orders" asp-action="Delete" asp-route-id="@Model.Id"
                              data-confirm="Delete order @Model.OrderNo? This can't be undone." data-confirm-text="Delete" data-confirm-style="btn-danger">
                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash"></i> Delete</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</article>
